# ──────────────────────────────────────────────────────────────────────────────
# BittensorDiscordAI – Configuration template
# Copiez ce fichier en .env et renseignez vos valeurs :
#   cp .env.example .env
# ──────────────────────────────────────────────────────────────────────────────

# Token Discord du bot utilisé pour scraper les channels
DISCORD_TOKEN=your_discord_token_here

# Clé API OpenRouter (LLM pour l'analyse IA)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# [Optionnel] Clé API Gemini si utilisée
# GEMINI_API_KEY=your_gemini_api_key_here
